{
  "name": "sovereign-will",
  "version": "0.1.8",
  "private": true,
  "description": "Sovereign Will: canvas strategy/survival game, packaged for Android with Capacitor",
  "scripts": {
    "start": "npx --yes serve www -l 8080",
    "lint": "npx --yes eslint@8 --no-eslintrc -c .eslintrc.json www/js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "test": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0"
  }
}
