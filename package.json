{
  "name": "sovereign-will",
  "version": "0.1.12",
  "private": true,
  "description": "Sovereign Will: canvas strategy/survival game, packaged for Android with Capacitor",
  "scripts": {
    "start": "npx --yes serve www -l 8080",
    "lint": "npx --yes eslint@8 --no-eslintrc -c .eslintrc.json --rulesdir tools/eslint-rules www/js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "test": "npm run test:node && playwright test",
    "test:node": "node --test 'tests/node/*.test.mjs'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "typescript": "5.6.3"
  }
}
