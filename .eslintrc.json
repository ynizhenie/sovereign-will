{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-redeclare": "error",
    "no-mixed-spaces-and-tabs": "off",
    "no-empty": "warn"
  }
}
