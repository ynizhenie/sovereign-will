{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "useUnknownInCatchVariables": true,
    "noImplicitReturns": true,
    "strictNullChecks": true
  },
  "include": [
    "www/js/**/*.js",
    "types/**/*.d.ts"
  ]
}
